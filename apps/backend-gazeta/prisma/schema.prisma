generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                   @id @default(autoincrement())
  email                String                @unique
  password             String
  name                 String
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  advertisements       Advertisement[]
  news                 News[]
  sectionOrderConfigs  SectionOrderConfig[]
  socialMediaConfig    SocialMediaConfig?
  topCategoriesConfigs TopCategoriesConfig[]
  userActivities       UserActivity[]
  maintenanceConfigs  MaintenanceConfig[]
  carouselConfigs     CarouselConfig[]

  @@map("users")
}

model Category {
  id                     Int                             @id @default(autoincrement())
  name                   String                          @unique
  description            String?                         @db.Text
  slug                   String                          @unique
  isActive               Boolean                         @default(true) @map("is_active")
  createdAt              DateTime                        @default(now()) @map("created_at")
  updatedAt              DateTime                        @updatedAt @map("updated_at")
  color                  String?                         @db.VarChar(20)
  newsCategories         NewsCategory[]
  topCategoriesRelations TopCategoriesCategoryRelation[]
  videoCategories        VideoCategory[]

  @@map("categories")
}

model News {
  id             Int            @id @default(autoincrement())
  title          String         @db.VarChar(255)
  subtitle       String         @db.Text
  content        String         @db.LongText
  author         String         @db.VarChar(200)
  published      String         @default("false") @db.VarChar(50)
  views          Int            @default(0)
  status         String         @default("ACTIVE") @db.VarChar(50)
  validity       String?        @db.VarChar(50)
  slug           String         @unique @db.VarChar(255)
  isEmphasis     Boolean        @default(false) @map("is_emphasis")
  createdAt      DateTime       @default(now()) @map("created_at")
  authorId       Int            @map("author_id")
  updateAt       DateTime       @updatedAt @map("update_at")
  authorUser     User           @relation(fields: [authorId], references: [id])
  newsCategories      NewsCategory[]
  mediaNews           NewsMedia[]
  videoNews           NewsVideo[]
  pageViews           PageView[]
  contentMedia        NewsContentMedia[]

  @@index([authorId], map: "news_author_id_fkey")
  @@index([status, published, createdAt])
  @@index([isEmphasis, status])
  @@index([slug])
  @@map("news")
}

model NewsMedia {
  id       Int     @id @default(autoincrement())
  emphasis Boolean @default(false)
  imgSize  String? @map("img_size") @db.LongText
  author   String? @db.VarChar(200)
  date     String? @db.VarChar(50)
  newsId   Int     @map("news_id")
  news     News    @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId], map: "news_media_news_id_fkey")
  @@map("news_media")
}

model NewsVideo {
  id        Int    @id @default(autoincrement())
  url       String @db.VarChar(500)
  thumbnail String @db.VarChar(500)
  newsId    Int    @map("news_id")
  news      News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId], map: "news_video_news_id_fkey")
  @@map("news_video")
}

model NewsCategory {
  newsId     Int      @map("news_id")
  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  news       News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@id([newsId, categoryId])
  @@index([categoryId], map: "news_categories_category_id_fkey")
  @@map("news_categories")
}

model Media {
  id        Int      @id @default(autoincrement())
  emphasis  Boolean  @default(false)
  imgSize   String?  @map("img_size") @db.LongText
  author    String?  @db.VarChar(200)
  date      String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("media")
}

model Video {
  id              Int             @id @default(autoincrement())
  title           String          @db.VarChar(255)
  url             String          @db.VarChar(500)
  thumbnail       String?         @db.VarChar(500)
  duration        String?         @db.VarChar(20)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  featured        Boolean         @default(false)
  tags            String?         @db.LongText
  views           Int             @default(0)
  description     String?         @db.Text
  newsSlug        String?         @db.VarChar(255)
  videoCategories VideoCategory[]

  @@map("videos")
}

model VideoCategory {
  videoId    Int      @map("video_id")
  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId, categoryId])
  @@index([categoryId], map: "video_categories_category_id_fkey")
  @@map("video_categories")
}

model Advertisement {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  description String?   @db.Text
  imageUrl    String    @map("image_url") @db.VarChar(500)
  clickUrl    String?   @map("click_url") @db.VarChar(500)
  position    String    @db.VarChar(100)
  placement   String    @db.VarChar(50)
  isActive    Boolean   @default(true) @map("is_active")
  priority    Int       @default(0)
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdBy   Int       @map("created_by")
  size        String    @default("728x90") @db.VarChar(20)
  creator     User      @relation(fields: [createdBy], references: [id])

  @@index([createdBy], map: "advertisement_created_by_fkey")
  @@index([placement, position, isActive], map: "advertisement_placement_position_active_idx")
  @@map("advertisements")
}

model TopCategoriesConfig {
  id         Int                             @id @default(autoincrement())
  type       String                          @db.VarChar(20)
  randomMode Boolean                         @default(false) @map("random_mode")
  createdAt  DateTime                        @default(now()) @map("created_at")
  updatedAt  DateTime                        @updatedAt @map("updated_at")
  createdBy  Int                             @map("created_by")
  categories TopCategoriesCategoryRelation[]
  creator    User                            @relation(fields: [createdBy], references: [id], map: "top_cat_configs_user_fkey")

  @@unique([type, createdBy])
  @@index([type])
  @@index([createdBy])
  @@map("top_categories_configs")
}

model TopCategoriesCategoryRelation {
  id                    Int                 @id @default(autoincrement())
  topCategoriesConfigId Int                 @map("top_categories_config_id")
  categoryId            Int                 @map("category_id")
  order                 Int                 @default(0)
  category              Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "top_cat_rel_category_fkey")
  topCategoriesConfig   TopCategoriesConfig @relation(fields: [topCategoriesConfigId], references: [id], onDelete: Cascade, map: "top_cat_rel_config_fkey")

  @@unique([topCategoriesConfigId, categoryId], map: "top_cat_rel_unique_key")
  @@index([topCategoriesConfigId], map: "top_cat_rel_config_id_idx")
  @@index([categoryId], map: "top_cat_rel_category_id_idx")
  @@map("top_categories_category_relations")
}

model SectionOrderConfig {
  id        Int      @id @default(autoincrement())
  sectionId String   @unique @map("section_id") @db.VarChar(50)
  name      String   @db.VarChar(100)
  title     String   @db.VarChar(200)
  order     Int      @unique
  showTitle Boolean  @default(true) @map("show_title")
  icon      String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy Int      @map("created_by")
  creator   User     @relation(fields: [createdBy], references: [id])

  @@index([order])
  @@index([createdBy], map: "section_order_configs_created_by_fkey")
  @@map("section_order_configs")
}

model SocialMediaConfig {
  id        Int      @id @default(autoincrement())
  instagram String?  @db.VarChar(500)
  facebook  String?  @db.VarChar(500)
  youtube   String?  @db.VarChar(500)
  linkedin  String?  @db.VarChar(500)
  twitter   String?  @db.VarChar(500)
  tiktok    String?  @db.VarChar(500)
  whatsapp  String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy Int      @unique @map("created_by")
  creator   User     @relation(fields: [createdBy], references: [id])

  @@map("social_media_configs")
}

model Menu {
  id           Int      @id @default(autoincrement())
  order        Int?     @map("order")
  name         String   @db.VarChar(255)
  type         String   @db.VarChar(50)
  slug         String?  @db.VarChar(255)
  routerLink   String?  @map("router_link") @db.VarChar(500)
  externalLink String?  @map("external_link") @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  parentId     Int?     @map("parent_id")
  parent       Menu?    @relation("MenuToSubmenu", fields: [parentId], references: [id], onDelete: Cascade)
  children     Menu[]   @relation("MenuToSubmenu")

  @@index([order, isActive], map: "menu_order_active_idx")
  @@index([parentId], map: "menu_parent_id_idx")
  @@map("menus")
}

model PageView {
  id         Int      @id @default(autoincrement())
  newsId     Int?     @map("news_id")
  path       String   @db.VarChar(500)
  userAgent  String?  @map("user_agent") @db.Text
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  referer    String?  @db.VarChar(500)
  sessionId  String?  @map("session_id") @db.VarChar(255)
  duration   Int?
  deviceType String?  @map("device_type") @db.VarChar(20)
  browser    String?  @db.VarChar(50)
  os         String?  @db.VarChar(50)
  country    String?  @db.VarChar(100)
  city       String?  @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")
  news       News?    @relation(fields: [newsId], references: [id])

  @@index([newsId], map: "page_views_news_id_fkey")
  @@index([createdAt])
  @@index([path, createdAt], map: "page_views_path_created_idx")
  @@map("page_views")
}

model ContentMedia {
  id                Int                 @id @default(autoincrement())
  url               String              @unique @db.VarChar(500)
  filePath          String              @db.VarChar(500) @map("file_path")
  createdAt         DateTime            @default(now()) @map("created_at")
  newsContentMedia  NewsContentMedia[]

  @@index([url], map: "content_media_url_idx")
  @@map("content_media")
}

model NewsContentMedia {
  id             Int          @id @default(autoincrement())
  newsId         Int          @map("news_id")
  contentMediaId Int          @map("content_media_id")
  news           News         @relation(fields: [newsId], references: [id], onDelete: Cascade)
  contentMedia   ContentMedia @relation(fields: [contentMediaId], references: [id], onDelete: Cascade)

  @@unique([newsId, contentMediaId], map: "news_content_media_unique")
  @@index([newsId], map: "news_content_media_news_id_idx")
  @@index([contentMediaId], map: "news_content_media_content_media_id_idx")
  @@map("news_content_media")
}

model UserActivity {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  action      String   @db.VarChar(100)
  entityType  String?  @map("entity_type") @db.VarChar(50)
  entityId    Int?     @map("entity_id")
  description String?  @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "user_activities_user_id_fkey")
  @@index([createdAt])
  @@index([action, createdAt], map: "user_activities_action_created_idx")
  @@map("user_activities")
}

model MaintenanceConfig {
  id        Int      @id @default(autoincrement())
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy Int      @map("created_by")
  creator   User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([createdBy])
  @@map("maintenance_configs")
}

model CarouselConfig {
  id              Int      @id @default(autoincrement())
  featuredNewsLimit Int    @default(5) @map("featured_news_limit")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       Int      @map("created_by")
  creator         User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy])
  @@map("carousel_configs")
}
