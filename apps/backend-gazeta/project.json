{
  "name": "backend-gazeta",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend-gazeta/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend-gazeta",
        "command": "npx prisma generate --schema=prisma/schema.prisma && webpack-cli build --node-env=production"
      },
      "configurations": {
        "production": {
          "command": "npx prisma generate --schema=prisma/schema.prisma && webpack-cli build --node-env=production"
        },
        "development": {
          "command": "npx prisma generate --schema=prisma/schema.prisma && webpack-cli build --node-env=development"
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "backend-gazeta:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "backend-gazeta:build:development"
        },
        "production": {
          "buildTarget": "backend-gazeta:build:production"
        }
      }
    }
  },
  "tags": []
}
