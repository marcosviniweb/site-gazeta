{
  "name": "painel-gazeta-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["painel-gazeta"],
  "projectType": "application",
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test",
        "cwd": "apps/painel-gazeta-e2e"
      },
      "dependsOn": ["painel-gazeta:serve"]
    },
    "e2e-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test --ui",
        "cwd": "apps/painel-gazeta-e2e"
      },
      "dependsOn": ["painel-gazeta:serve"]
    },
    "e2e-headed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test --headed",
        "cwd": "apps/painel-gazeta-e2e"
      },
      "dependsOn": ["painel-gazeta:serve"]
    },
    "e2e-report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright show-report ../../dist/e2e-report",
        "cwd": "apps/painel-gazeta-e2e"
      }
    },
    "e2e-master": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test src/master.spec.ts --headed",
        "cwd": "apps/painel-gazeta-e2e"
      },
      "dependsOn": ["painel-gazeta:serve"]
    }
  }
}
