{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@site-gazeta/ads": ["libs/components/ads/src/index.ts"],
      "@site-gazeta/ads-config": ["libs/ts/types/index.ts"],
      "@site-gazeta/alert": ["libs/shared/alert/src/index.ts"],
      "@site-gazeta/carousel": ["libs/components/carousel/src/index.ts"],
      "@site-gazeta/color-picker": [
        "libs/components/color-picker/src/index.ts"
      ],
      "@site-gazeta/dark-mode": ["libs/shared/dark-mode/src/index.ts"],
      "@site-gazeta/drag-and-drop": [
        "libs/components/drag-and-drop/src/index.ts"
      ],
      "@site-gazeta/editor": ["libs/components/editor/src/index.ts"],
      "@site-gazeta/footer": ["libs/components/footer/src/index.ts"],
      "@site-gazeta/form-validator": [
        "libs/shared/form-validator/src/index.ts"
      ],
      "@site-gazeta/gallery": ["libs/components/gallery/src/index.ts"],
      "@site-gazeta/header": ["libs/components/header/src/index.ts"],
      "@site-gazeta/home-components": [
        "libs/components/home-components/src/index.ts"
      ],
      "@site-gazeta/menu": ["libs/components/menu/src/index.ts"],
      "@site-gazeta/mock": ["libs/ts/mock/index.ts"],
      "@site-gazeta/modal": ["libs/shared/modal/src/index.ts"],
      "@site-gazeta/models": ["libs/ts/models/index.ts"],
      "@site-gazeta/more-news": ["libs/components/more-news/src/index.ts"],
      "@site-gazeta/multi-select": ["libs/shared/multi-select/src/index.ts"],
      "@site-gazeta/related-news": [
        "libs/components/related-news/src/index.ts"
      ],
      "@site-gazeta/side-news": ["libs/components/side-news/src/index.ts"],
      "@site-gazeta/sidebar": ["libs/shared/sidebar/src/index.ts"],
      "@site-gazeta/text-editor": ["libs/components/text-editor/src/index.ts"],
      "@site-gazeta/video-components": [
        "libs/components/video-components/src/index.ts"
      ],
      "@site-gazeta/video-player": ["libs/components/video-player/src/index.ts"],
      "@site-gazeta/api": ["libs/api/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
